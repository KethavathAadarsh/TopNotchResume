# Anthropic Claude — powers every agent and extraction call
ANTHROPIC_API_KEY=sk-ant-...

# Model override (optional — defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL_FAST=claude-sonnet-5

# Thinking/output depth: low | medium | high | xhigh | max
# Blank uses the API default (high). Lower it to trade quality for latency+cost.
# ANTHROPIC_EFFORT=

# Optional — ONLY used by the semantic embedding layer (Anthropic has no
# embeddings API). Leave blank to use the built-in lexical fallback.
# OPENAI_API_KEY=sk-...

# App
DEBUG=false
DOWNLOADS_DIR=downloads
DOWNLOAD_TTL_SECONDS=3600

# CORS — frontend origin
ALLOWED_ORIGINS=["http://localhost:3000"]
